# HealthWalk Backend — Environment Variables
# Скопировать в .env и заполнить реальными значениями

# ── Server ──
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# ── CORS ──
# Домен фронтенда (для API запросов)
CORS_ORIGIN=https://healthwalk.example.com

# ── Supabase (серверный ключ — для API роутов) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Daily.co (для видеозвонков — будущее) ──
# DAILY_API_KEY=
# DAILY_WEBHOOK_SECRET=

# ── Push уведомления (будущее) ──
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@healthwalk.example.com
