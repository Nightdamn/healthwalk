# InStep Backend

# Server
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=instep
DB_USER=instep
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# App URLs
APP_URL=https://instep.life
FRONTEND_URL=https://instep.life
CORS_ORIGIN=https://instep.life

# Google OAuth (optional — get from console.cloud.google.com)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
