# HealthWalk — systemd service
# Место: /etc/systemd/system/healthwalk.service
#
# Команды:
#   systemctl enable healthwalk        # автозапуск
#   systemctl start healthwalk         # запуск
#   systemctl stop healthwalk          # остановка
#   systemctl restart healthwalk       # перезапуск
#   journalctl -u healthwalk -f        # логи

[Unit]
Description=HealthWalk Web Application
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/healthwalk/backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
EnvironmentFile=/opt/healthwalk/backend/.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/healthwalk
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=healthwalk

[Install]
WantedBy=multi-user.target
